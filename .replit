modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cmake", "freetype", "gcc", "glib", "lcms2", "libGL", "libGLU", "libgcc", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "pkg-config", "python3Full", "tcl", "tk", "unixODBC", "xsimd", "zlib", "xorg.libxcb", "xorg.xcbutilwm", "xorg.xcbutilimage", "xorg.xcbutilkeysyms", "xorg.xcbutilrenderutil", "xorg.libX11", "libxkbcommon", "qt5.qtbase"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Face Verification App"

[[workflows.workflow]]
name = "Face Verification App"
author = "agent"

[workflows.workflow.metadata]
outputType = "vnc"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "QT_QPA_PLATFORM=vnc python face_verification_app.py"
